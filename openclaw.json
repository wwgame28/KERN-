{
  "agents": {
    "defaults": {
      "workspace": "/data/workspace",
      "model": {
        "primary": "qwen-direct/qwen3.5-plus"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "qwen-direct": {
        "baseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
        "apiKey": "${QWEN_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen3.5-plus",
            "name": "Qwen 3.5 Plus",
            "input": ["text", "image"]
          }
        ]
      }
    }
  }
}
